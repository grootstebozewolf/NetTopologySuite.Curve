<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <RootNamespace>NetTopologySuite.Test</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetTopologySuite.Curved\NetTopologySuite.Curve.csproj" />
    <!--
      Spike-only reference to the proprietary clothoid-halley-coq C# library.
      Used by test/Spike/* to construct chord-clothoid-chord polylines from
      G^1 Hermite data.  The production NetTopologySuite.Curve assembly is
      netstandard2.0 and intentionally does NOT depend on this library
      (Clothoid.Halley targets net8.0).  The dependency lives at the test
      layer only and is gated by file existence so the build still works
      without a sibling clothoid-halley-coq checkout.
    -->
    <ProjectReference
        Include="..\..\..\clothoid-halley-coq\csharp\Clothoid.Halley\Clothoid.Halley.csproj"
        Condition="Exists('..\..\..\clothoid-halley-coq\csharp\Clothoid.Halley\Clothoid.Halley.csproj')" />
  </ItemGroup>

  <PropertyGroup
      Condition="Exists('..\..\..\clothoid-halley-coq\csharp\Clothoid.Halley\Clothoid.Halley.csproj')">
    <DefineConstants>$(DefineConstants);CLOTHOID_HALLEY_AVAILABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="IO\" />
  </ItemGroup>

</Project>
