# Submodule tracks upstream `NetTopologySuite/NetTopologySuite` `develop`.
# Curve / Surface / ILinearizable infrastructure is vendored fork-locally in
# `src/NetTopologySuite.Curved/Compat/` (dovetail sessions 2–9).  Session 10
# adds a CI lane to catch future upstream drift early.
[submodule "NetTopologySuite"]
	path = NetTopologySuite
	url = https://github.com/NetTopologySuite/NetTopologySuite.git
	branch = develop
